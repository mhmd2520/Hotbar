{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotbar",
  "version": "0.1.7",
  "identifier": "dev.mkhaled.hotbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotbar",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEM0MzNTU2NjIzMkVDRTMKUldUajdESmlWalU4N2FHdTFXL2FpS0tHN1duNTdGc3FBaVlyUXA5SW54RS80c295QVR0d3hRLy8K",
      "endpoints": ["https://github.com/mhmd2520/Hotbar/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
